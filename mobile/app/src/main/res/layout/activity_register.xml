<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginBottom="16dp"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create account"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join TeknoyFix today"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginBottom="24dp"/>

        <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@drawable/bg_error"
                android:textColor="@color/red"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                  android:text="Username" android:textSize="13sp" android:textColor="@color/text_secondary"
                  android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etUsername" android:layout_width="match_parent"
                  android:layout_height="48dp" android:background="@drawable/bg_input"
                  android:paddingHorizontal="14dp" android:hint="johndoe"
                  android:textSize="14sp" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                  android:text="Email address" android:textSize="13sp" android:textColor="@color/text_secondary"
                  android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etEmail" android:layout_width="match_parent"
                  android:layout_height="48dp" android:background="@drawable/bg_input"
                  android:paddingHorizontal="14dp" android:inputType="textEmailAddress"
                  android:hint="you@cit.edu" android:textSize="14sp" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                  android:text="Password" android:textSize="13sp" android:textColor="@color/text_secondary"
                  android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etPassword" android:layout_width="match_parent"
                  android:layout_height="48dp" android:background="@drawable/bg_input"
                  android:paddingHorizontal="14dp" android:inputType="textPassword"
                  android:hint="Min. 6 characters" android:textSize="14sp" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                  android:text="Confirm password" android:textSize="13sp" android:textColor="@color/text_secondary"
                  android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etConfirm" android:layout_width="match_parent"
                  android:layout_height="48dp" android:background="@drawable/bg_input"
                  android:paddingHorizontal="14dp" android:inputType="textPassword"
                  android:hint="Repeat password" android:textSize="14sp" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                  android:text="I am a" android:textSize="13sp" android:textColor="@color/text_secondary"
                  android:textStyle="bold" android:layout_marginBottom="6dp"/>

        <Spinner android:id="@+id/spinnerRole" android:layout_width="match_parent"
                 android:layout_height="48dp" android:background="@drawable/bg_input"
                 android:layout_marginBottom="24dp"/>

        <Button android:id="@+id/btnRegister" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="@string/register"
                android:backgroundTint="@color/maroon" android:textColor="@color/white"
                android:textSize="15sp" android:layout_marginBottom="16dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:text="Already have an account? " android:textColor="@color/text_tertiary"
                      android:textSize="13sp"/>
            <TextView android:id="@+id/tvLogin" android:layout_width="wrap_content"
                      android:layout_height="wrap_content" android:text="Sign in"
                      android:textColor="@color/maroon" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>